[Unit]
Description=NLS Router control client
Documentation=https://github.com/TamilSelvam22112003/Nls-NetOS-v0.1.1/blob/feat/handshake-m1-m4/docs/INSTALL.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/nls-router/router.env

[Service]
Type=simple
User=nls-router
Group=nls-router
EnvironmentFile=/etc/nls-router/router.env
ExecStart=/usr/local/libexec/nls-router-control
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nls-router
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
