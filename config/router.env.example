# Copy to /etc/nls-router/router.env and edit. Values are required by nls-router control.
CA_ADDRESS=127.0.0.1:8444
CA_TLS_NAME=ca.example.invalid
CA_CERT=/etc/nls-router/ca-cert.pem
CA_FINGERPRINT=REPLACE_WITH_SHA256_OF_CA_CERT_DER
ROUTER_CERT=/etc/nls-router/router-cert.pem
ROUTER_KEY=/etc/nls-router/router-key.pem
STATE_DIR=/var/lib/nls-router
SYNC_INTERVAL=5s
CONTROL_LOSS_TIMEOUT=5m
